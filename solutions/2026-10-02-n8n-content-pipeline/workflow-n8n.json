{"active":false,"connections":{"Apply Settings (Code)":{"main":[[{"index":0,"node":"Loop Over Items","type":"main"}]]},"Attempts >= 3?":{"main":[[{"index":0,"node":"Mark Failed (Sheets)","type":"main"}],[{"index":0,"node":"Loop Over Items","type":"main"}]]},"Build SEO Payload (Code)":{"main":[[{"index":0,"node":"Publish to WordPress","type":"main"}]]},"Daily Schedule":{"main":[[{"index":0,"node":"Read Queue (Sheets)","type":"main"}]]},"Generate Article (Claude)":{"main":[[{"index":0,"node":"Build SEO Payload (Code)","type":"main"}],[{"index":0,"node":"Handle Failure (Code)","type":"main"}]]},"Handle Failure (Code)":{"main":[[{"index":0,"node":"Attempts >= 3?","type":"main"}]]},"Loop Over Items":{"main":[[{"index":0,"node":"Generate Article (Claude)","type":"main"}]]},"Mark Failed (Sheets)":{"main":[[{"index":0,"node":"Loop Over Items","type":"main"}]]},"Mark Published (Sheets)":{"main":[[{"index":0,"node":"Loop Over Items","type":"main"}]]},"Ping Sitemap":{"main":[[{"index":0,"node":"Mark Published (Sheets)","type":"main"}]]},"Publish to WordPress":{"main":[[{"index":0,"node":"Ping Sitemap","type":"main"}],[{"index":0,"node":"Handle Failure (Code)","type":"main"}]]},"Read Queue (Sheets)":{"main":[[{"index":0,"node":"Read Settings","type":"main"}]]},"Read Settings":{"main":[[{"index":0,"node":"Apply Settings (Code)","type":"main"}]]}},"meta":{"templateCredsSetupCompleted":false},"name":"BlogFlow — Content Pipeline (Sheets → Claude → WordPress)","nodes":[{"id":"bf-schedule","name":"Daily Schedule","parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":24}]}},"position":[240,300],"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2},{"credentials":{"googleSheetsOAuth2Api":{"id":"REPLACE","name":"Google Sheets"}},"id":"bf-read-queue","name":"Read Queue (Sheets)","parameters":{"documentId":{"__rl":true,"mode":"id","value":"REPLACE_WITH_SHEET_ID"},"filtersUI":{"values":[{"lookupColumn":"status","lookupValue":"queued"}]},"operation":"read","resource":"sheetWithinDocument","sheetName":{"__rl":true,"mode":"name","value":"queue"}},"position":[460,300],"type":"n8n-nodes-base.googleSheets","typeVersion":4.5},{"id":"bf-apply-settings","name":"Apply Settings (Code)","parameters":{"jsCode":"// Apply settings: FIFO oldest-first, daily limit from Settings tab (never hardcoded).\nconst dailyLimit = parseInt($('Read Settings').first().json.value || '5', 10);\nconst publishedToday = $('Read Queue (Sheets)').all()\n  .filter(r => r.json.status === 'published' &&\n    (r.json.published_at || '').startsWith(new Date().toISOString().slice(0, 10)))\n  .length;\nconst remaining = Math.max(0, dailyLimit - publishedToday);\nconst queued = items\n  .filter(i => i.json.status === 'queued')\n  .sort((a, b) => new Date(a.json.created_at) - new Date(b.json.created_at))\n  .slice(0, remaining);\nreturn queued;"},"position":[900,300],"type":"n8n-nodes-base.code","typeVersion":2},{"credentials":{"googleSheetsOAuth2Api":{"id":"REPLACE","name":"Google Sheets"}},"id":"bf-read-settings","name":"Read Settings","parameters":{"documentId":{"__rl":true,"mode":"id","value":"REPLACE_WITH_SHEET_ID"},"operation":"read","sheetName":{"__rl":true,"mode":"name","value":"settings"}},"position":[680,460],"type":"n8n-nodes-base.googleSheets","typeVersion":4.5},{"id":"bf-loop","name":"Loop Over Items","parameters":{},"position":[1120,300],"type":"n8n-nodes-base.splitInBatches","typeVersion":3},{"credentials":{"httpHeaderAuth":{"id":"REPLACE","name":"Anthropic API Key"}},"id":"bf-claude","name":"Generate Article (Claude)","parameters":{"headerParameters":{"parameters":[{"name":"x-api-key","value":"={{ $credentials.anthropicApi.apiKey }}"},{"name":"anthropic-version","value":"2023-06-01"}]},"jsonBody":"={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 2000, messages: [{ role: 'user', content: 'Write a publish-ready finance article about \"' + $json.keyword + '\" (kind: ' + $json.kind + '): H1, definition, worked numeric example, FAQ. Return JSON with title, content, excerpt.' }] }) }}","method":"POST","options":{"response":{"response":{"responseFormat":"json"}}},"sendBody":true,"sendHeaders":true,"specifyBody":"json","url":"https://api.anthropic.com/v1/messages"},"position":[1340,300],"settings":{"onError":"continueErrorOutput"},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2},{"id":"bf-seo","name":"Build SEO Payload (Code)","parameters":{"jsCode":"// Build SEO payload: Rank Math style title/meta, alt text = focus keyword.\nconst item = $('Loop Over Items').first().json;\nconst gen = JSON.parse($json.content[0].text);\nconst year = new Date().getFullYear();\nconst settings = Object.fromEntries($('Read Settings').all().map(r => [r.json.key, r.json.value]));\nreturn [{\n  json: {\n    ...item,\n    gen_title: gen.title,\n    gen_content: gen.content,\n    seo_title: (settings.seo_title_template || '{keyword} — Complete Guide {year}')\n      .replace('{keyword}', item.keyword.charAt(0).toUpperCase() + item.keyword.slice(1))\n      .replace('{year}', year),\n    meta_description: (settings.meta_description_template || 'Learn {keyword}.')\n      .replace('{keyword}', item.keyword),\n    alt_text: item.focus_keyword\n  }\n}];"},"position":[1560,300],"type":"n8n-nodes-base.code","typeVersion":2},{"credentials":{"httpBasicAuth":{"id":"REPLACE","name":"WordPress App Password"}},"id":"bf-wp","name":"Publish to WordPress","parameters":{"authentication":"genericCredentialType","genericAuthType":"httpBasicAuth","jsonBody":"={{ JSON.stringify({ title: $json.gen_title, content: $json.gen_content, status: 'publish', meta: { rank_math_title: $json.seo_title, rank_math_description: $json.meta_description } }) }}","method":"POST","options":{"response":{"response":{"responseFormat":"json"}}},"sendBody":true,"specifyBody":"json","url":"={{ $env.WP_SITE_URL }}/wp-json/wp/v2/posts"},"position":[1780,300],"settings":{"onError":"continueErrorOutput"},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2},{"id":"bf-sitemap","name":"Ping Sitemap","parameters":{"method":"GET","url":"={{ $env.WP_SITE_URL }}/wp-sitemap-posts-post-1.xml"},"position":[2000,300],"type":"n8n-nodes-base.httpRequest","typeVersion":4.2},{"credentials":{"googleSheetsOAuth2Api":{"id":"REPLACE","name":"Google Sheets"}},"id":"bf-mark-published","name":"Mark Published (Sheets)","parameters":{"columns":{"mappingMode":"defineBelow","matchingColumns":["id"],"value":{"alt_text":"={{ $('Build SEO Payload (Code)').first().json.alt_text }}","attempts":"={{ parseInt($json.attempts || '0', 10) + 1 }}","meta_description":"={{ $('Build SEO Payload (Code)').first().json.meta_description }}","published_at":"={{ new Date().toISOString() }}","seo_title":"={{ $('Build SEO Payload (Code)').first().json.seo_title }}","status":"published","title":"={{ $json.gen_title }}","wp_post_id":"={{ $json.id }}"}},"documentId":{"__rl":true,"mode":"id","value":"REPLACE_WITH_SHEET_ID"},"operation":"update","resource":"sheetWithinDocument","sheetName":{"__rl":true,"mode":"name","value":"queue"}},"position":[2220,300],"type":"n8n-nodes-base.googleSheets","typeVersion":4.5},{"id":"bf-handle-failure","name":"Handle Failure (Code)","parameters":{"jsCode":"// One item failure never stops the run: bump attempts, fail only after 3.\nconst item = $('Loop Over Items').first().json;\nconst attempts = parseInt(item.attempts || '0', 10) + 1;\nreturn [{ json: { ...item, attempts, should_fail: attempts >= 3 } }];"},"position":[1340,520],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"bf-if-failed","name":"Attempts >= 3?","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"c1","leftValue":"={{ $json.should_fail }}","operator":{"operation":"equals","type":"boolean"},"rightValue":true}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"}}},"position":[1560,520],"type":"n8n-nodes-base.if","typeVersion":2.2},{"credentials":{"googleSheetsOAuth2Api":{"id":"REPLACE","name":"Google Sheets"}},"id":"bf-mark-failed","name":"Mark Failed (Sheets)","parameters":{"columns":{"mappingMode":"defineBelow","matchingColumns":["id"],"value":{"attempts":"={{ $json.attempts }}","error":"={{ $json.error?.message || 'failed' }}","status":"failed"}},"documentId":{"__rl":true,"mode":"id","value":"REPLACE_WITH_SHEET_ID"},"operation":"update","resource":"sheetWithinDocument","sheetName":{"__rl":true,"mode":"name","value":"queue"}},"position":[1780,460],"type":"n8n-nodes-base.googleSheets","typeVersion":4.5},{"id":"bf-note","name":"Sticky Note","parameters":{"content":"## Setup\n1. Replace REPLACE_WITH_SHEET_ID with your Google Sheet ID (tabs: queue, settings, log, social_queue, newsletter_queue).\n2. Set env vars WP_SITE_URL, and credentials: Google Sheets OAuth, Anthropic API key, WordPress app password.\n3. Import this JSON into n8n (Workflows → Import from File). All REPLACE credentials will prompt you to reconnect.\n\nRules baked in: FIFO queue, daily limit from Settings tab, 3 retries then Failed, single failures never stop the run, SEO title/meta + alt text on every publish, sitemap pinged after each publish.","height":420,"width":560},"position":[180,560],"type":"n8n-nodes-base.stickyNote","typeVersion":1}],"pinData":{},"settings":{"executionOrder":"v1"}}